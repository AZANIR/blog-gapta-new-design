:80 {
    root * /var/www/html
    encode gzip

    # Wrapped in route{} so directives run in the order written below —
    # Caddy's default global order runs header BEFORE try_files, so the
    # @html matcher never saw the rewritten "/" -> "/index.html" path.
    route {
        # SPA fallback
        try_files {path} {path}.html {path}/ /index.html

        # Cache static assets
        @static path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2
        header @static Cache-Control "public, max-age=31536000, immutable"

        # No cache for HTML
        @html path *.html
        header @html Cache-Control "no-cache, no-store, must-revalidate"

        # Security headers
        header {
            X-Content-Type-Options "nosniff"
            X-Frame-Options "SAMEORIGIN"
            Referrer-Policy "strict-origin-when-cross-origin"
        }

        file_server
    }

    # Custom 404
    handle_errors {
        rewrite * /404.html
        file_server
    }
}
